<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>au.com.assetize.maximotools</groupId>
    <artifactId>mockkit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mockkit-profile-mas92</artifactId>
  <name>Maximo Mockito MBO kit (MAS 9.2 profile)</name>
  <description>
    IBM-typed adapters for the 9.2 lens. Compiles ONLY when the IBM Manage
    JARs have been extracted into mockkit/libs/9.2/ (see libs/README.md);
    the parent activates this module on that file's presence. The JARs are
    IBM-licensed and must never be committed.
  </description>

  <dependencies>
    <dependency>
      <groupId>au.com.assetize.maximotools</groupId>
      <artifactId>mockkit-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- Extracted from your MAS 9.2 admin pod; system scope keeps it out of any repository. -->
      <groupId>com.ibm.maximo</groupId>
      <artifactId>businessobjects</artifactId>
      <version>9.2-local</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/../libs/9.2/businessobjects.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <maximo.lens>9.2</maximo.lens>
            <maximo.dictionaries>${project.basedir}/../../dictionaries</maximo.dictionaries>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

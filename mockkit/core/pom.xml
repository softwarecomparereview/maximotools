<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>au.com.assetize.maximotools</groupId>
    <artifactId>mockkit-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mockkit-core</artifactId>
  <name>Maximo Mockito MBO kit (core, IBM-free)</name>
  <description>
    Version-agnostic mock kit: fluent MockMboSet builder over Mockito,
    fail-closed attribute dictionary, and the @EvidencedOn JUnit 5
    extension. Compiles and tests with no IBM JARs present — all
    psdi-touching code lives behind the seam interfaces in
    au.com.assetize.maximotools.mockkit.seam, with IBM-typed adapters in
    the profile modules.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- Active version lens; override per run: mvn -Dmaximo.lens=9.2 verify -->
            <maximo.lens>${maximo.lens}</maximo.lens>
            <!-- Dictionaries root; defaults to the committed synthetic samples -->
            <maximo.dictionaries>${project.basedir}/../../dictionaries/_synthetic</maximo.dictionaries>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
